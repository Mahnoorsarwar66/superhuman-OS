# Later, add these locations to the dedicated Forge site's server block.
# Let Forge manage its domain, SSL certificate and HTTP -> HTTPS redirect.
# Use /home/forge/superhuman/public-empty as the site's empty web root.
# Replace the site's existing root location; do not duplicate location /.
location ^~ /data/ { deny all; }
location ^~ /superhuman/ { deny all; }
location ^~ /backups/ { deny all; }
location ^~ /superhuman-deploy-v19/ { deny all; }
location = /requirements.txt { deny all; }
location = /requirements-v19.txt { deny all; }
location / {
    client_max_body_size 12m;
    proxy_pass http://127.0.0.1:8000;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_read_timeout 150s;
}
